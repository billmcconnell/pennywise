NODE_ENV=development
PORT=3000
HOST=127.0.0.1

DATABASE_URL=postgres://pennywise:pennywise@localhost:5432/pennywise

# Auth.js — set a random 32+ byte secret for prod. Dev resolver bypasses.
AUTH_SECRET=dev-secret-change-me

# Set to "dev" to use the no-magic-link dev resolver (auto-login as the seeded household).
AUTH_MODE=dev

# Production base URL — used to build magic-link verify URLs.
APP_URL=https://pennywise.mcconnalino.com

# Comma-separated list of emails allowed to sign in (leave blank to allow all).
ALLOWED_EMAILS=

# SMTP via Resend (https://resend.com → Domains → verify mcconnalino.com → API Keys)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=Pennywise <noreply@pennywise.mcconnalino.com>

# Anthropic LLM (Phase 2). Leave blank for Phase 0/1.
ANTHROPIC_API_KEY=

# Static web build path (relative to api package). Vite builds here.
WEB_DIST=../web/dist
