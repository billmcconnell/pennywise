NODE_ENV=development
PORT=3000
HOST=127.0.0.1

DATABASE_URL=postgres://pennywise:pennywise@localhost:5432/pennywise

# Auth.js — set a random 32+ byte secret for prod. Dev resolver bypasses.
AUTH_SECRET=dev-secret-change-me

# Set to "dev" to use the no-magic-link dev resolver (auto-login as the seeded household).
AUTH_MODE=dev

# Anthropic LLM (Phase 2). Leave blank for Phase 0/1.
ANTHROPIC_API_KEY=

# Static web build path (relative to api package). Vite builds here.
WEB_DIST=../web/dist
